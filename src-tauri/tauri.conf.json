{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XiaoyinMarkdown",
  "version": "2.6.1",
  "identifier": "com.xiaoyin.markdown",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "未命名 — 小银 Markdown",
        "width": 1380,
        "height": 880,
        "minWidth": 860,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdwn"
        ],
        "name": "XiaoyinMarkdown.Document",
        "description": "Markdown 文档 — 小银 Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "XiaoyinMarkdown.Text",
        "description": "文本文档 — 小银 Markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}